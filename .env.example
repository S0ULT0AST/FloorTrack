# Copy to .env.local. Local values come from `supabase status -o env`.
# Do not commit real project keys.

# Supabase API URL. Local default: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# New publishable key (sb_publishable_...) or the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional fallback if you only have the legacy anon key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. New secret key (sb_secret_...) or the legacy service_role key.
# Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this Next.js app. Used in auth redirects and invite links.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43123

# Comma-separated emails that become platform owners on sign-in.
# The check runs on the server. It does not trust client-editable user metadata.
PLATFORM_OWNER_EMAILS=owner@floortrack.test
